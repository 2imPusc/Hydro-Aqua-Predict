POSTGRES_DB=context_research
POSTGRES_USER=context_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://context_user:change_me@postgres:5432/context_research
CONTEXT_LATITUDE=20.71894498573044
CONTEXT_LONGITUDE=107.042635855355
CONTEXT_SNAPSHOT_MINUTES=30
CONTEXT_STALE_MINUTES=90
CONTEXT_BUFFER_M=5000
# Direct GreenLab sensor pilot (leave credentials blank to disable polling).
GREENLAB_API_ENABLED=true
GREENLAB_API_BASE_URL=https://thegreenlab.xyz
TK_DHTB=
MK_DHTB=
GREENLAB_STATION_SERIALS=06M26042804
SENSOR_POLL_SECONDS=60
SENSOR_STALE_MINUTES=10
# Optional token protecting external POST ingestion.
SENSOR_INGEST_TOKEN=
# Optional Copernicus enhancement. Leave blank to keep the layer unavailable.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
COPERNICUS_PHYSICS_DATASET=
COPERNICUS_CURRENT_DATASET=
COPERNICUS_SEA_LEVEL_DATASET=
COPERNICUS_MLD_DATASET=
COPERNICUS_WAVE_DATASET=
# Optional local GEBCO subset GeoTIFF. Put it at ./cache/gebco.tif, or set
# GEBCO_HOST_DIR and GEBCO_RASTER_PATH to a different mounted file.
GEBCO_HOST_DIR=./cache
GEBCO_RASTER_PATH=/gebco/gebco.tif
# Browser origins allowed by the API (comma-separated). Default: vite 5173/5174 and 8083 on localhost + 127.0.0.1.
# CORS_ALLOW_ORIGINS=
