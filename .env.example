# Copy to `.env` and fill in local credentials. Never commit `.env`.
# Loaded by core/config.py (Python) and ingest/*.js (Node).

# MongoDB source (legacy path; GreenLab REST API is preferred)
MONGODB_URI=
MONGODB_DB_NAME=data
MONGODB_COLLECTION_NAME=quan_trac

# GreenLab REST API credentials
TK_DHTB=
MK_DHTB=

# Data source: live = fetch latest snapshot then read history; cache = offline, history only
GREENLAB_FETCH_MODE=live
# Read data/greenlab/greenlab_export.csv instead of the API (dev only)
USE_LOCAL_CSV=false

# NH4 -> NH3 (validated lab setting: raw NH4 is µg/L, converted to mg/L).
NH4_UNIT_SCALE=0.001
NH4_CONVERSION_CONFIRMED=true
NH4_UNIT_NOTE=raw_NH4_ug_per_L_to_mg_per_L_validated_lab

# Open-Meteo weather enrichment (no API key). Observation-only; never drives alerts directly.
WEATHER_ENABLED=true
WEATHER_PROVIDER=open_meteo
WEATHER_CACHE_TTL_MINUTES=60
# Station-level marine point context. Keep false until installation GPS is surveyed.
MARINE_ENABLED=false
MARINE_PROVIDER=open_meteo
# WEATHER_06M26042804_LATITUDE=20.71894498573044
# WEATHER_06M26042804_LONGITUDE=107.042635855355

# Optional path overrides (see core/paths.py)
# HAP_DATA_DIR=
# HAP_RUNTIME_DIR=
# HAP_ARTIFACTS_DIR=
# HAP_WATER_SHAPEFILE=
